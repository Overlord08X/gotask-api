meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  const data = res.getBody().data;
  if (data && data.token) {
    bru.setEnvVar("token", data.token);
    bru.setEnvVar("userId", data.user.id);
  }
}
